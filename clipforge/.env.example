# ClipForge Configuration
# Copy to .env and fill in your values

# === Work Directory (use /shared for disk space) ===
WORK_DIR=/shared/clipforge
MAX_CONCURRENT_JOBS=2

# === ASR Configuration ===
WHISPER_MODEL=medium          # tiny/base/small/medium/large-v3/distil-large-v3
WHISPER_DEVICE=cuda           # cuda or cpu
WHISPER_COMPUTE=int8_float16  # float16/int8_float16/int8
# medium + int8_float16 = ~2.5GB VRAM, leaves room for YOLOv8n + MediaPipe
# large-v3-turbo + fp16 = ~4.5GB — too tight on 6GB with other models loaded

# === LLM Configuration ===
LLM_BACKEND=ollama            # ollama or gemini
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b       # Already installed on this machine
# GEMINI_API_KEY=              # Optional: better moment detection + layout picking

# === Publishing ===
# YouTube (direct API — free, 100 uploads/day as of Nov 2, 2026)
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=/shared/clipforge/state/youtube_token.json

# Instagram (requires App Review — free, 2-4 weeks)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# TikTok (via Upload-Post — 10 free/month)
UPLOAD_POST_API_KEY=

# === Telegram Approval Gate ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPROVAL_REQUIRED=true         # Keep true to avoid YouTube inauthentic-content flag

# === Scrapling (web scraping) ===
SCRAPLING_HEADLESS=true
SCRAPLING_STEALTH=true

# === Pipeline Behavior ===
CLIP_MIN_DURATION=15           # seconds
CLIP_MAX_DURATION=60           # seconds
MAX_CLIPS_PER_VIDEO=10         # Gemini/Ollama picks the best N
REFRAME_MODE=auto              # auto/track/general/split/screencast
BURN_SUBTITLES=true
NVENC_PRESET=p4                # p1(fastest)..p7(best quality)
AUTO_CLEANUP_HOURS=24          # Delete work files after N hours
