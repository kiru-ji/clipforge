# ClipForge v2 Environment Configuration
# Copy to .env and fill via web UI or manually

# Groq (Speech-to-Text) — FREE tier, no GPU needed
GROQ_API_KEY=

# Qwen / ModelScope (LLM) — Your existing key
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# YouTube Publishing — 100 uploads/day free
YOUTUBE_CLIENT_SECRETS=

# TikTok via Upload-Post — 10 free/month
UPLOAD_POST_API_KEY=

# Server
HOST=0.0.0.0
PORT=8080
ADMIN_PASSWORD=changeme

# Pipeline
WORK_DIR=/tmp/clipforge
CLIP_MIN_DURATION=15
CLIP_MAX_DURATION=60
MAX_CLIPS_PER_VIDEO=8
FFMPEG_THREADS=2
